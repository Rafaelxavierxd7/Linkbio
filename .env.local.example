# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase
# (Painel do Supabase > Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Esta chave é SECRETA. Nunca coloque "NEXT_PUBLIC_" nela nem exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta

# Opcional, mas recomendado em produção: salt usado para gerar o hash do IP
# de quem clica (nunca guardamos o IP bruto). Troque por um valor aleatório próprio.
IP_HASH_SALT=troque-por-um-valor-aleatorio-longo
